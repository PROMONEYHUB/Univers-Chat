# Bot token created via @BotFather on Telegram (KEEP SECRET — NEVER put in Android APK!)
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOTFATHER_TOKEN

# Public @username of your Telegram bot (without @), e.g., UniversChatOtpBot
TELEGRAM_BOT_USERNAME=UniversChatOtpBot

# Secret header sent by Telegram on webhook requests (set via setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret

# Set to "true" for zero-config local/VPS long-polling (no webhook URL needed).
# Set to "false" in production when using HTTPS webhooks at POST /api/telegram/webhook.
TELEGRAM_POLLING=true

# Strong random secret (32+ chars) for signing HS256 session JWTs
JWT_SECRET=replace-with-a-strong-32-byte-random-secret
JWT_EXPIRES_IN=7d

# Firestore database ID used by Univers Chat
FIREBASE_DATABASE_ID=ai-studio-android-pulsecha-e97cfd46-bc45-4fb2-80d8-677c380a25e2

# Provide either GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# or FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
GOOGLE_APPLICATION_CREDENTIALS=

PORT=8080
